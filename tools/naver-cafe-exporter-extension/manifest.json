{
  "manifest_version": 3,
  "name": "Naver Cafe My Post Exporter",
  "version": "0.1.0",
  "description": "Exports visible Naver Cafe post summaries from the currently logged-in browser tab.",
  "permissions": ["activeTab", "scripting", "downloads", "tabs"],
  "host_permissions": ["https://cafe.naver.com/*", "https://apis.naver.com/*"],
  "action": {
    "default_title": "Export visible cafe posts",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://cafe.naver.com/*"],
      "js": [
        "src/shared/logger.js",
        "src/content/postExtractor.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
